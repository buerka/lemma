#!/usr/bin/env python3
"""Lemma remote runner.

Reads run_spec.json, verifies declared input hashes when the files exist,
executes the command, records the remote git/environment fingerprint, and writes
manifest.json, metrics.json, result.json and remote_result.json into the run
directory.

This file is intentionally dependency-free and does not import lemma.
"""

import argparse
import hashlib
import json
import os
import subprocess
import time


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()


def sha256_text(text):
    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def run_command(command, cwd=None, env=None):
    """Run a command and return (returncode, combined stdout/stderr)."""
    try:
        proc = subprocess.run(
            command,
            cwd=cwd,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        return proc.returncode, (proc.stdout or "").strip()
    except Exception as exc:  # noqa: BLE001 - runner must report any failure
        return 1, str(exc)


def collect_code(workdir, spec):
    """Record the code state that actually exists on the remote host."""
    code = dict(spec.get("code") or {})
    rc, repo = run_command(["git", "rev-parse", "--show-toplevel"], cwd=workdir)
    if rc == 0 and repo:
        code["repo"] = repo
    rc, commit = run_command(["git", "rev-parse", "HEAD"], cwd=workdir)
    if rc == 0 and commit:
        code["commit"] = commit
    rc_diff, diff = run_command(["git", "diff", "HEAD"], cwd=workdir)
    rc_status, status = run_command(
        ["git", "status", "--porcelain", "--untracked-files=all"], cwd=workdir
    )
    if rc_diff == 0 and rc_status == 0:
        if status:
            code["dirty"] = True
            code["patch_hash"] = sha256_text(diff + "\n--status--\n" + status)
        else:
            code["dirty"] = False
            code["patch_hash"] = ""
    return code


def collect_environment(python, workdir, env):
    """Record remote interpreter/driver hashes, omitting unavailable tools."""
    environment = {}
    rc, version = run_command([python, "--version"], cwd=workdir, env=env)
    if rc == 0 and version:
        environment["python_version"] = version.splitlines()[0]
    rc, freeze = run_command([python, "-m", "pip", "freeze"], cwd=workdir, env=env)
    if rc == 0:
        environment["pip_freeze_hash"] = sha256_text(freeze)
    rc, nvidia = run_command(["nvidia-smi"], cwd=workdir, env=env)
    if rc == 0:
        environment["nvidia_smi_hash"] = sha256_text(nvidia)
    environment_hash = sha256_text(
        json.dumps(environment, sort_keys=True, separators=(",", ":"))
    )
    return environment, environment_hash


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--spec", required=True)
    args = ap.parse_args()

    with open(args.spec) as f:
        spec = json.load(f)

    run_id = spec["run_id"]
    run_dir = os.path.dirname(os.path.abspath(args.spec))
    started = now()
    exit_code = 0
    status = "succeeded"
    error = ""

    workdir = os.path.expanduser(spec.get("workdir") or os.getcwd())
    run_env = os.environ.copy()
    run_env.update(spec.get("env") or {})

    for item in spec.get("inputs", []):
        path = os.path.expanduser(item.get("path", ""))
        expected = item.get("sha256", "")
        if path and expected and os.path.exists(path):
            actual = sha256_file(path)
            if actual != expected:
                print("input hash mismatch: %s expected=%s actual=%s" % (path, expected, actual))
                status, exit_code, error = "failed", 3, "input hash mismatch: " + path
                break

    if status == "succeeded":
        try:
            proc = subprocess.run(
                spec["command"],
                shell=True,
                cwd=workdir,
                env=run_env,
            )
            exit_code = proc.returncode
            if exit_code != 0:
                status = "failed"
                error = "command exited with %d" % exit_code
        except Exception as exc:  # noqa: BLE001 - runner must report any failure
            exit_code = 1
            status = "failed"
            error = str(exc)

    remote_code = collect_code(workdir, spec)
    environment, environment_hash = collect_environment(
        spec.get("python") or "python3", workdir, run_env
    )

    finished = now()
    artifacts = []
    for name in spec.get("outputs", []):
        path = os.path.join(run_dir, name)
        if os.path.isfile(path):
            artifacts.append({
                "name": os.path.basename(name),
                "uri": "remote://%s/%s" % (run_id, name),
                "sha256": sha256_file(path),
                "size": os.path.getsize(path),
            })

    files = []
    for root, _dirs, names in os.walk(run_dir):
        for name in sorted(names):
            if name in ("manifest.json", "remote_result.json"):
                continue
            path = os.path.join(root, name)
            rel = os.path.relpath(path, run_dir)
            files.append({
                "path": rel,
                "sha256": sha256_file(path),
                "size": os.path.getsize(path),
            })

    metrics = {}
    metrics_path = os.path.join(run_dir, "metrics.json")
    if os.path.isfile(metrics_path):
        try:
            with open(metrics_path) as f:
                metrics = json.load(f)
        except Exception:
            metrics = {}

    manifest = {
        "run_id": run_id,
        "created_at": finished,
        "files": files,
        "artifacts": artifacts,
    }
    with open(os.path.join(run_dir, "manifest.json"), "w") as f:
        json.dump(manifest, f, indent=2, sort_keys=True)
        f.write("\n")

    result = {
        "run_id": run_id,
        "project": spec.get("project"),
        "task_id": spec.get("task_id"),
        "status": status,
        "exit_code": exit_code,
        "started_at": started,
        "finished_at": finished,
        "metrics": metrics,
        "artifacts": artifacts,
        "manifest": manifest,
        "error": error,
        "code": remote_code,
        "environment": environment,
        "environment_hash": environment_hash,
        "config_hash": spec.get("config_hash", ""),
        "data": spec.get("data"),
    }
    for name in ("result.json", "remote_result.json"):
        with open(os.path.join(run_dir, name), "w") as f:
            json.dump(result, f, indent=2, sort_keys=True)
            f.write("\n")

    print(json.dumps({"run_id": run_id, "status": status, "exit_code": exit_code}))


if __name__ == "__main__":
    main()
