{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buerka/lemma/schemas/changeset.schema.json",
  "title": "Lemma changeset",
  "type": "object",
  "required": ["changeset_id", "project", "intent", "base_revision", "operations", "created_at", "prev_hash", "hash"],
  "additionalProperties": false,
  "properties": {
    "changeset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "project": {"type": "string", "minLength": 1},
    "task_id": {"type": "string"},
    "intent": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {"enum": ["task.update", "run.append"]},
          "id": {"type": "string"},
          "from": {"enum": ["todo", "doing", "blocked", "done"]},
          "to": {"enum": ["todo", "doing", "blocked", "done"]},
          "run_id": {"type": "string"}
        }
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "string"},
    "created_at": {"type": "string"},
    "prev_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
